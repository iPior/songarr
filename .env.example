# Songarr acquisition-pipeline spike - example configuration.
#
# Copy to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials. Placeholders only in this file.

# --- Prowlarr -------------------------------------------------------------------------
# Base URL of your Prowlarr instance, reachable from wherever you run the spike.
PROWLARR_URL=http://localhost:9696
# Settings -> General -> Security -> API Key in the Prowlarr UI.
PROWLARR_API_KEY=replace-with-your-prowlarr-api-key

# --- qBittorrent ----------------------------------------------------------------------
# Base URL of the qBittorrent Web UI. If qBittorrent runs behind Gluetun, use the address
# Gluetun publishes the Web UI on, not the qBittorrent container name.
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=replace-with-your-qbittorrent-password

# --- Songarr ownership ----------------------------------------------------------------
# The qBittorrent category Songarr claims. Every torrent it creates is tagged with this
# category plus a per-request tag, and it refuses to modify anything lacking both.
# Do NOT point this at a category another Arr application already uses.
SONGARR_CATEGORY=songarr

# --- Paths ----------------------------------------------------------------------------
# IMPORTANT: remote path mapping is out of scope for the MVP, so this single path is used
# BOTH as the save path handed to qBittorrent AND as the directory the spike reads the
# finished file from. Songarr and qBittorrent must therefore see the same path.
#
# If qBittorrent runs in Docker and saves to /downloads inside its container, the spike
# must also see that same directory at /downloads - bind-mount it identically, or run the
# spike on the host with a matching path. If they disagree, the spike fails at the
# validation step with SOURCE_MISSING and says so.
SONGARR_DOWNLOAD_ROOT=/absolute/path/to/downloads

# If qBittorrent runs on ANOTHER machine, run with --skip-publish: the path above is then
# only sent to qBittorrent and is not checked locally, and the line below may be left unset.
# See "Testing against a remote stack" in docs/spike.md.

# Where validated tracks are published. Songarr writes here and nowhere else.
# It creates <ready>/.processing/ for in-flight copies and <ready>/<Artist>/ for results.
# Optional only when running with --skip-publish.
SONGARR_READY_ROOT=/absolute/path/to/ready

# --- Behaviour ------------------------------------------------------------------------
# Release ranking hint: flac | mp3_320 | any. Ranking only - nothing is ever filtered out.
SONGARR_PREFERRED_QUALITY=any

# How long to wait for a torrent's file list before giving up (seconds).
SONGARR_METADATA_TIMEOUT_SEC=120

# How often to poll qBittorrent while waiting or downloading (seconds).
SONGARR_POLL_INTERVAL_SEC=5

# Abandon a download that has made no progress on the selected file for this long (seconds).
SONGARR_STALL_TIMEOUT_SEC=900

# Executable name or absolute path for audio validation.
FFPROBE_PATH=ffprobe

# debug | info | warn | error. Secrets are redacted from logs at every level.
SONGARR_LOG_LEVEL=info
